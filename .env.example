# ============================================================================
# CONFIGURACIÓN DEL PROYECTO AUTOMATIONQA
# ============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo a .env
# 2. Reemplaza los valores de ejemplo con tus datos reales
# 3. NUNCA commites el archivo .env a git
# ============================================================================

# ============================================================================
# IDENTIFICACIÓN DEL PROYECTO
# ============================================================================
PROYECTO=GETNET

# ============================================================================
# AMBIENTE DE EJECUCIÓN
# ============================================================================
# Valores permitidos: QA, CERT, PROD, STAGING
# Las credenciales deben existir como USER_<AMBIENTE> y PASSWORD_<AMBIENTE>
AMBIENTE=QA

# ============================================================================
# URL BASE DE LA APLICACIÓN
# ============================================================================
# URL donde se ejecutarán los tests. Debe incluir protocolo (http/https)
URL=https://tu-url-qa.getnet.com

# ============================================================================
# CREDENCIALES - AMBIENTE QA
# ============================================================================
USER_QA=usuario_test_qa
PASSWORD_QA=contraseña_test_qa

# ============================================================================
# CREDENCIALES - AMBIENTE CERT
# ============================================================================
# Descomenta las siguientes líneas si necesitas ejecutar en CERT
# USER_CERT=usuario_test_cert
# PASSWORD_CERT=contraseña_test_cert

# ============================================================================
# CREDENCIALES - AMBIENTE PROD (USAR CON CUIDADO)
# ============================================================================
# Descomenta solo si se requiere testing en PROD
# USER_PROD=usuario_test_prod
# PASSWORD_PROD=contraseña_test_prod

# ============================================================================
# CONFIGURACIÓN DEL NAVEGADOR
# ============================================================================
# Navegador a usar: chromium (recomendado), firefox, webkit
BROWSER=chromium

# Modo headless (sin interfaz gráfica)
# true = sin interfaz visual (más rápido)
# false = con interfaz visual (mejor para debugging)
HEADLESS=false

# ============================================================================
# TIMEOUTS
# ============================================================================
# Timeout global en milisegundos para esperar elementos
# Recomendado: 30000 ms (30 segundos) para ambientes remotos
# Reducir a 15000 ms para ambientes locales rápidos
TIMEOUT=30000

# ============================================================================
# CAPTURA DE EVIDENCIAS
# ============================================================================
# Capturar screenshot automáticamente si falla un test
SCREENSHOT_ON_FAIL=true

# Grabar traza de Playwright si falla un test (incluye video, DOM snapshots)
TRACE_ON_FAIL=true
